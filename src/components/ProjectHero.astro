---
import ProjectLinks from "@/components/ProjectLinks.astro";
import { formatDate } from "@/lib/dates";

type ProjectLinks = {
  paper?: string;
  code?: string;
  demo?: string;
  video?: string;
  dataset?: string;
  model?: string;
  website?: string;
};

type Props = {
  title: string;
  description: string;
  authors?: string[];
  affiliations?: string[];
  venue?: string;
  publishedAt?: Date;
  links?: ProjectLinks;
};

const {
  title,
  description,
  authors = [],
  affiliations = [],
  venue,
  publishedAt,
  links,
} = Astro.props;
---

<header class="project-hero">
  <a href="../" class="text-link">Back to Projects</a>
  <div class="project-hero__copy">
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
  {
    (authors.length > 0 || affiliations.length > 0 || venue || publishedAt) && (
      <div class="project-hero__meta">
        {authors.length > 0 && <p>{authors.join(", ")}</p>}
        {affiliations.length > 0 && <p>{affiliations.join(" · ")}</p>}
        {(venue || publishedAt) && (
          <p>
            {[venue, publishedAt ? formatDate(publishedAt) : undefined]
              .filter(Boolean)
              .join(" · ")}
          </p>
        )}
      </div>
    )
  }
  <ProjectLinks links={links} />
</header>
