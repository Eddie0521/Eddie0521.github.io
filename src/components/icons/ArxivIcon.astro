---
type Props = {
  size?: number;
};

const { size = 20 } = Astro.props;
---

<span class="arxiv-icon" style={`font-size: ${size}px`} aria-hidden="true"></span>

<style>
  @font-face {
    font-family: "Academicons";
    src: url("/fonts/academicons.woff") format("woff");
    font-display: block;
    font-style: normal;
    font-weight: 400;
  }

  .arxiv-icon {
    display: inline-block;
    font-family: "Academicons";
    font-style: normal;
    font-variant: normal;
    font-weight: 400;
    line-height: 1;
    text-rendering: auto;
    -moz-osx-font-smoothing: grayscale;
    -webkit-font-smoothing: antialiased;
  }

  .arxiv-icon::before {
    content: "\e974";
  }
</style>
