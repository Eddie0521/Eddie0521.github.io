---
import { withBase } from "@/lib/url";

type Props = {
  title: string;
  description: string;
  favicon?: string;
  navItems?: {
    label: string;
    href: string;
  }[];
};

const { title, description, favicon, navItems = [] } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {favicon && <link rel="icon" href={withBase(favicon)} type="image/png" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css?family=Google+Sans|Noto+Sans|Castoro"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class:list={["paper-page", { "paper-page--with-nav": navItems.length > 0 }]}>
    {
      navItems.length > 0 && (
        <header class="paper-site-header">
          <div class="paper-container">
            <nav class="paper-main-nav" aria-label="Project navigation">
              <ul class="paper-nav-links">
                {navItems.map((item, index) => (
                  <li>
                    <a href={item.href} class:list={{ active: index === 0 }}>
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </header>
      )
    }
    <slot />
    {
      navItems.length > 0 && (
        <script is:inline>
          const navLinks = Array.from(document.querySelectorAll(".paper-nav-links a"));
          const sections = navLinks
            .map((link) => document.querySelector(link.getAttribute("href")))
            .filter(Boolean);

          const syncActiveNav = () => {
            const current = sections
              .filter((section) => section.getBoundingClientRect().top <= 96)
              .at(-1);

            navLinks.forEach((link) => {
              link.classList.toggle(
                "active",
                Boolean(current) && link.getAttribute("href") === `#${current.id}`,
              );
            });
          };

          window.addEventListener("scroll", syncActiveNav, { passive: true });
          syncActiveNav();
        </script>
      )
    }
  </body>
</html>

<style is:global>
  html {
    background: #fff;
  }

  body.paper-page {
    margin: 0;
    color: #4a4a4a;
    font-family: "Noto Sans", "Google Sans", Arial, sans-serif;
    font-size: 16px;
    line-height: 1.55;
  }

  .paper-site-header {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 1px 5px rgba(0, 0, 0, 0.1);
  }

  .paper-main-nav {
    display: flex;
    justify-content: center;
    padding: 6px 0;
  }

  .paper-nav-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 26px;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .paper-nav-links a {
    position: relative;
    display: inline-flex;
    padding-bottom: 3px;
    color: #2d3748;
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .paper-nav-links a::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: #667eea;
    transition: width 180ms ease;
  }

  .paper-nav-links a:hover,
  .paper-nav-links a.active {
    color: #667eea;
  }

  .paper-nav-links a:hover::after,
  .paper-nav-links a.active::after {
    width: 100%;
  }

  .paper-page--with-nav .paper-hero {
    padding-top: 82px;
  }

  .paper-page a {
    color: #3273dc;
    text-decoration: none;
  }

  .paper-page a:hover {
    color: #1f4bb6;
  }

  .paper-page .paper-container {
    box-sizing: border-box;
    width: min(calc(100% - 32px), 960px);
    margin: 0 auto;
  }

  .paper-page .paper-container--wide {
    max-width: 1180px;
  }

  .paper-page h1 {
    width: 100%;
    max-width: 960px;
    margin: 0 auto 22px;
    color: #363636;
    font-family: "Google Sans", "Noto Sans", Arial, sans-serif;
    font-size: clamp(2rem, 4.8vw, 3rem);
    font-weight: 600;
    line-height: 1.12;
    overflow-wrap: break-word;
  }

  .paper-page h2,
  .paper-page h3 {
    color: #363636;
    font-family: "Google Sans", "Noto Sans", Arial, sans-serif;
    text-align: center;
  }

  .paper-page h2 {
    margin: 0 0 28px;
    font-size: 2rem;
    font-weight: 600;
  }

  .paper-page h2::after {
    content: "";
    display: block;
    width: min(100%, 1040px);
    height: 1px;
    margin: 16px auto 0;
    background: #d9d9d9;
  }

  .paper-page h3 {
    margin: 28px 0 18px;
    font-size: 1.42rem;
    font-weight: 500;
  }

  .paper-page .paper-section {
    padding: 46px 0;
    scroll-margin-top: 82px;
  }

  .paper-page .paper-section--tight {
    padding-top: 30px;
  }

  .paper-page .paper-image {
    display: block;
    width: min(100%, 1040px);
    height: auto;
    margin: 0 auto;
  }

  .paper-page .paper-image--medium {
    width: min(100%, 960px);
  }

  .paper-page .paper-image--narrow {
    width: min(100%, 720px);
  }

  .paper-page .paper-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    gap: 7px;
    padding: 8px 15px;
    border-radius: 999px;
    background: #363636;
    color: #fff;
    font-size: 0.96rem;
    line-height: 1;
    transition: background 160ms ease, transform 160ms ease;
  }

  .paper-page .paper-button:hover {
    background: #1f1f1f;
    color: #fff;
  }

  .paper-page .paper-button:active {
    transform: scale(0.97);
  }

  .paper-page .paper-button--disabled {
    cursor: default;
    opacity: 0.72;
  }

  .paper-page .paper-button__icon {
    display: inline-flex;
    align-items: center;
  }

  @media (max-width: 720px) {
    .paper-main-nav {
      padding: 5px 0;
    }

    .paper-nav-links {
      gap: 4px 10px;
    }

    .paper-nav-links a {
      padding: 2px 2px 3px;
      font-size: 0.82rem;
      white-space: nowrap;
    }

    .paper-page--with-nav .paper-hero {
      padding-top: 92px;
    }

    .paper-page .paper-section {
      padding: 34px 0;
    }

    .paper-page h1 {
      font-size: clamp(1.68rem, 7.5vw, 2rem);
    }

    .paper-page .paper-button {
      min-height: 36px;
      padding: 8px 13px;
      font-size: 0.92rem;
    }
  }
</style>
