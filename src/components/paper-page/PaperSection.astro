---
type Props = {
  title: string;
  wide?: boolean;
  tight?: boolean;
};

const { title, wide = false, tight = false } = Astro.props;
---

<section class:list={["paper-section", { "paper-section--tight": tight }]}>
  <div class:list={["paper-container", { "paper-container--wide": wide }]}>
    <h2>{title}</h2>
    <slot />
  </div>
</section>
