---
import { ArrowRight, ExternalLink, Mail } from "@lucide/astro";
import GitHubIcon from "@/components/icons/GitHubIcon.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import NewsList from "@/components/NewsList.astro";
import ProjectPublicationRow from "@/components/ProjectPublicationRow.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import { getBlogPostHref, getBlogPosts, getProjects, getSiteConfig } from "@/lib/content-data";
import { formatDate } from "@/lib/dates";
import { withBase } from "@/lib/url";

const site = await getSiteConfig();
const projects = await getProjects();
const featuredProjects = [
  ...projects.filter((project) => project.featured),
  ...projects.filter((project) => !project.featured),
].slice(0, 2);
const posts = (await getBlogPosts()).slice(0, 3);
---

<BaseLayout>
  <section class="hero" aria-labelledby="intro-title">
    <div class="hero__avatar">
      <img src={withBase(site.avatar)} alt={`${site.name} avatar`} width="160" height="160" />
      {site.location && <p class="kicker">{site.location}</p>}
    </div>

    <div class="hero__intro">
      {site.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="hero__identity">
      <h1 id="intro-title">{site.name}</h1>
      {site.role && <p>{site.role}</p>}
    </div>

    <div class="social-row" aria-label="External links">
      {
        site.socialLinks.map(({ label, href }) => (
          <a href={withBase(href)} aria-label={label} title={label}>
            {label === "GitHub" ? (
              <GitHubIcon size={20} />
            ) : label === "Email" ? (
              <Mail aria-hidden="true" size={20} stroke-width={1.8} />
            ) : (
              <ExternalLink aria-hidden="true" size={20} stroke-width={1.8} />
            )}
          </a>
        ))
      }
    </div>
  </section>

  <section class="content-band" aria-labelledby="news-title">
    <SectionTitle title="News" />
    <NewsList />
  </section>

  <section class="content-band" aria-labelledby="projects-title">
    <div class="section-header-link">
      <SectionTitle title="Projects" />
      <a class="text-link" href={withBase("/projects/")}>
        All projects
        <ArrowRight aria-hidden="true" size={17} stroke-width={1.8} />
      </a>
    </div>
    <div class="project-publication-list">
      {featuredProjects.map((project) => <ProjectPublicationRow project={project} />)}
    </div>
  </section>

  <section class="content-band" aria-labelledby="writing-title">
    <div class="section-header-link">
      <SectionTitle title="Blogs" />
      <a class="text-link" href={withBase("/blog/")}>
        All posts
        <ArrowRight aria-hidden="true" size={17} stroke-width={1.8} />
      </a>
    </div>
    <div class="post-list">
      {
        posts.map((post) => (
          <a class="post-row" href={withBase(getBlogPostHref(post))}>
            <time datetime={post.data.publishedAt.toISOString()}>
              {formatDate(post.data.publishedAt)}
            </time>
            <span>
              <strong>{post.data.title}</strong>
              <small>{post.data.description}</small>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
