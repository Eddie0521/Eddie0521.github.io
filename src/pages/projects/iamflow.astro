---

<PaperPageLayout
  title="IAMFlow"
  description={description}
  favicon="/projects/iamflow/icon.png"
  navItems={navItems}
>
  <PaperHero
    title={title}
    logos={logos}
    authors={authors}
    affiliations={affiliations}
    links={links}
  />

  <main>
    <PaperSection id="highlights" title="Highlights" tight>
      <div class="highlights-list">
        {
          highlights.map((highlight, index) => (
            <p>
              <strong>({index + 1})</strong> {highlight.lead}{" "}
              <strong
                class:list={{
                  "highlight-keyword":
                    highlight.strong === "IAMFlow" ||
                    highlight.strong === "NarraStream-Bench",
                }}
              >
                {highlight.strong}
              </strong>, {highlight.rest}
            </p>
          ))
        }
      </div>
      <img
        src={withBase("/projects/iamflow/teaser-figure.png")}
        class="paper-image paper-image--medium"
        alt="IAMFlow teaser"
        loading="lazy"
      />
    </PaperSection>

    <PaperSection id="demo" title="Demo Videos" wide>
      <PaperVideoGrid videos={demoVideos} />
    </PaperSection>

    <PaperSection id="method" title="Method: IAMFlow" wide>
      <h3>Framework of IAMFlow</h3>
      <img
        src={withBase("/projects/iamflow/framework.png")}
        class="paper-image"
        alt="Framework of IAMFlow"
        loading="lazy"
      />
    </PaperSection>

    <PaperSection id="benchmark" title="Benchmark: NarraStream-Bench" wide>
      <h3>Overview of NarraStream-Bench</h3>
      <img
        src={withBase("/projects/iamflow/narrastream-bench.png")}
        class="paper-image"
        alt="Overview of NarraStream-Bench"
        loading="lazy"
      />

      <h3>Benchmark Comparison</h3>
      <p class="table-caption">
        <strong>Comparison of related long-video generation benchmarks.</strong> The custom
        VBench-Long protocol only supports metrics for visual quality.
      </p>
      <PaperBenchmarkTable rows={benchmarkRows} />
    </PaperSection>

    <PaperSection id="experiments" title="Experiments" wide>
      <h3>Qualitative Visualization</h3>
      <img
        src={withBase("/projects/iamflow/qualitative-results.png")}
        class="paper-image"
        alt="Qualitative results of IAMFlow under NarraStream-Bench"
        loading="lazy"
      />

      <h3>Quantitative Comparison</h3>
      <p class="table-caption">
        <strong>Quantitative comparison for the multi-prompt 60-second setting on
        NarraStream-Bench.</strong> Self Forcing, Rolling Forcing, and Deep Forcing are adapted
        for the experiment. Best results are in bold, and second-best results are underlined.
      </p>
      <PaperResultTable groups={resultGroups} overallLabel="Overall ↑" rows={resultRows} />
    </PaperSection>

    <PaperSection id="citation" title="BibTeX">
      <pre class="bibtex"><code>{bibtex}</code></pre>
    </PaperSection>

    <PaperFooterLinks links={footerLinks} />
  </main>
</PaperPageLayout>

<style>
  :global(.paper-logo.iamflow-logo) {
    width: 33.333%;
    max-width: 320px;
    max-height: none;
  }

  .highlights-list {
    max-width: 860px;
    margin: 0 auto 24px;
    font-size: 1.06rem;
  }

  .highlights-list p {
    margin: 0 0 14px;
  }

  .highlight-keyword {
    color: #b5261c;
  }

  .table-caption {
    max-width: 920px;
    margin: 0 auto 14px;
    color: #555;
    text-align: center;
  }

  .bibtex {
    overflow-x: auto;
    margin: 0;
    padding: 16px;
    border-radius: 6px;
    background: #f5f5f5;
    color: #363636;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.92rem;
  }
</style>
